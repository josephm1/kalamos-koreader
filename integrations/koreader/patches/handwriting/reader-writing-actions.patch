 function TouchMenu:switchMenuTab(tab_num)
+    -- Action tabs are explicitly activated, never remembered on automatic menu opening.
+    local tab = self.tab_item_table[tab_num]
+    if tab and tab.activate_callback then
+        if self.touch_menu_callback then
+            self.touch_menu_callback()
+        end
+        self:onClose()
+        UIManager:tickAfterNext(tab.activate_callback)
+        return
+    end
     if self.tab_item_table[tab_num].remember ~= false then
         self.last_index = tab_num
     end
