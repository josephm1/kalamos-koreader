+package org.koreader.launcher
+
+import android.app.Activity
+
+/** No native AARs, hidden-API access or input ownership in the default distribution. */
+@Suppress("UNUSED_PARAMETER")
+internal object KalamosInkAdapter {
+    private const val UNAVAILABLE = "{\"ok\":false,\"err\":\"Native handwriting is not enabled in this build\"}"
+    fun ping(activity: Activity): String = "{\"ok\":true,\"apiVersion\":1,\"inkAvailable\":false}"
+    fun startInk(activity: Activity, bounds: String): String = UNAVAILABLE
+    fun penMotion(activity: Activity, json: String): String = UNAVAILABLE
+    fun stopInk(activity: Activity): String = UNAVAILABLE
+    fun pauseInk(activity: Activity): String = UNAVAILABLE
+    fun drainInk(): String = UNAVAILABLE
+    fun isPenInputActive(): Boolean = false
+    fun isPenInputDevice(deviceId: Int): Boolean = false
+}
