+package org.koreader.launcher
+
+import android.app.Activity
+import com.kalamos.koreader.KalamosBridge
+
+/** Compiled only by the explicitly enabled native-ink distribution. */
+internal object KalamosInkAdapter {
+    fun ping(activity: Activity): String = KalamosBridge.ping(activity)
+    fun startInk(activity: Activity, bounds: String): String = KalamosBridge.startInk(activity, bounds)
+    fun penMotion(activity: Activity, json: String): String = KalamosBridge.penMotion(activity, json)
+    fun stopInk(activity: Activity): String = KalamosBridge.stopInk(activity)
+    fun pauseInk(activity: Activity): String = KalamosBridge.pauseInk(activity)
+    fun drainInk(): String = KalamosBridge.drainInk()
+    fun isPenInputActive(): Boolean = KalamosBridge.isPenInputActive()
+    fun isPenInputDevice(deviceId: Int): Boolean = KalamosBridge.isPenInputDevice(deviceId)
+}
