diff --git a/make/android.mk b/make/android.mk
--- a/make/android.mk
+++ b/make/android.mk
@@ -2,5 +2,9 @@
 ANDROID_VERSION ?= $(shell git rev-list --count HEAD)
 ANDROID_NAME ?= $(VERSION)
 ANDROID_APK = koreader-android-$(ANDROID_ARCH)$(KODEDUG_SUFFIX)-$(ANDROID_NAME).apk
+KALAMOS_ASSET_REVISION = $(shell sha256sum \
+	plugins/kalamos.koplugin/*.lua plugins/kalamos.koplugin/resources/icons/kalamos.svg \
+	base/ffi/input_android.lua \
+	platform/android/luajit-launcher/app/libs/kalamos-*.aar 2>/dev/null | sha256sum | cut -c1-12)
 
 # Run. {{{
@@ -94,5 +97,5 @@ update-apk: all
 	# APK version.
 	mkdir -p $(ANDROID_ASSETS)/module $(ANDROID_LIBS)
-	echo '$(VERSION)_$(DIST)' >$(ANDROID_ASSETS)/module/version.txt
+	echo '$(VERSION)_$(DIST)_kalamos-$(KALAMOS_ASSET_REVISION)' >$(ANDROID_ASSETS)/module/version.txt
 	# Libraries.
 	cp -v $(INSTALL_DIR)/koreader/libs/*$(LIB_EXT) $(ANDROID_LIBS)/
